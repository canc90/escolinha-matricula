# Ambiente de produção.
#
# Uso:
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml build
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# O arquivo .env.production nao deve ser versionado.

APP_NAME="Gestão Escolar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://escola.exemplo.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Logs rotacionados por dia com retenção de LOG_DAILY_DAYS (14 por padrão); com
# LOG_LEVEL=warning o volume é pequeno, mas a rotação garante o limite do disco.
# Os arquivos vivem dentro do volume app-storage (compartilhado por app, queue e
# scheduler) e NÃO aparecem no host — para ler:
#   P="docker compose -p escola-prod --env-file .env.production -f docker-compose.prod.yml"
#   $P exec -u www-data app sh -c 'tail -n 200 "$(ls -1t storage/logs/laravel-*.log | head -1)"'
# (o fuso do shell do container é UTC e o do app é America/Sao_Paulo: por isso a
# leitura usa o arquivo datado mais recente em vez de montar a data pelo shell.)
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Alerta de erro 5xx: cole aqui um webhook de n8n/Slack/Discord. Enquanto estiver
# vazio, cada erro 5xx fica registrado em storage/logs/alertas-*.log (canal com
# retenção própria). Timeouts curtos impedem um webhook fora do ar de prender o
# container; o teto global evita enxurrada quando vários erros ocorrem juntos.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT=5
ALERT_WEBHOOK_CONNECT_TIMEOUT=2
ALERT_DEDUP_MINUTES=10
ALERT_MAX_PER_HOUR=30

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=escola
DB_USERNAME=escola
# Obrigatorios: defina com senhas fortes.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Backup do banco e dos uploads (comando `php artisan escola:backup`, agendado
# as 02:30 pelo servico `scheduler`).
# Este caminho e exatamente o destino do bind mount declarado em
# docker-compose.prod.yml (variavel BACKUP_HOST_PATH, padrao ./backups) nos
# servicos app e scheduler. Sem essa montagem o backup ficaria apenas dentro do
# volume nomeado app-storage, preso no Docker e irrecuperavel pelo host.
# O diretorio do host pode ser trocado sem editar codigo (a variavel e lida pelo
# compose; deixe como esta para usar ./backups):
BACKUP_HOST_PATH=./backups
BACKUP_PATH=/var/www/html/storage/app/backups
BACKUP_RETENTION_DAYS=14

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Exige HTTPS. Em teste via http://localhost, use false.
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@escola.exemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

# Expiração dos tokens da API, em minutos (7 dias). Deixe vazio para nao expirar.
SANCTUM_TOKEN_EXPIRATION=10080

# Proxies confiaveis (tunel/Cloudflare). Use "*" quando a aplicacao so recebe
# trafego do proxy.
TRUSTED_PROXIES=*

# IA Educacional (Google Gemini). Sem chave, o sistema usa recomendacoes locais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
