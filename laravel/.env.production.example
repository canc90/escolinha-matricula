# Ambiente de produção.
#
# Uso:
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml build
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# O arquivo .env.production nao deve ser versionado.

APP_NAME="Gestão Escolar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://escola.exemplo.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=escola
DB_USERNAME=escola
# Obrigatorios: defina com senhas fortes.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Backup do banco e dos uploads (comando `php artisan escola:backup`, agendado
# as 02:30 pelo servico `scheduler`).
# Este caminho e exatamente o destino do bind mount declarado em
# docker-compose.prod.yml (variavel BACKUP_HOST_PATH, padrao ./backups) nos
# servicos app e scheduler. Sem essa montagem o backup ficaria apenas dentro do
# volume nomeado app-storage, preso no Docker e irrecuperavel pelo host.
# O diretorio do host pode ser trocado sem editar codigo:
#   BACKUP_HOST_PATH=/srv/escola-backups docker compose --env-file .env.production -f docker-compose.prod.yml up -d
BACKUP_PATH=/var/www/html/storage/app/backups
BACKUP_RETENTION_DAYS=14

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Exige HTTPS. Em teste via http://localhost, use false.
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@escola.exemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

# Expiração dos tokens da API, em minutos (7 dias). Deixe vazio para nao expirar.
SANCTUM_TOKEN_EXPIRATION=10080

# Proxies confiaveis (tunel/Cloudflare). Use "*" quando a aplicacao so recebe
# trafego do proxy.
TRUSTED_PROXIES=*

# IA Educacional (Google Gemini). Sem chave, o sistema usa recomendacoes locais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
