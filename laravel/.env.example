APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Proxies confiáveis para os cabeçalhos X-Forwarded-* (detecta HTTPS e monta
# URLs corretas atrás de proxy). Use "*" para confiar em qualquer proxy
# (Cloudflare Tunnel em dev / nginx em produção) ou IPs/CIDRs separados por
# vírgula. Vazio desativa.
TRUSTED_PROXIES=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Backup do banco e dos uploads (comando `php artisan escola:backup`).
# Em desenvolvimento nao e preciso configurar nada: o repositorio e montado em
# /var/www/html, entao storage/app/backups ja aparece no host, e
# `docker compose exec app php artisan escola:backup` grava direto no repositorio.
# BACKUP_PATH vazio usa storage/app/backups.
BACKUP_PATH=
BACKUP_RETENTION_DAYS=14
# Binarios usados pelo backup/restauracao (sobrescreva se nao estiverem no PATH).
# BACKUP_MYSQLDUMP_BINARY=mysqldump
# BACKUP_MYSQL_BINARY=mysql
# BACKUP_TAR_BINARY=tar

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IA Educacional (Google Gemini). Sem chave, o sistema usa recomendações locais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
